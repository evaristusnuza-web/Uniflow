# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy?schema=public

# Use a unique random value outside local development.
JWT_SECRET=replace-this-with-a-long-random-secret

# The first account registered with this email receives the ADMIN role.
ADMIN_EMAIL=

# Comma-separated browser origins allowed to call the API directly.
CLIENT_ORIGIN=http://localhost:4173

PORT=3000
UPLOAD_DIR=./uploads

# Optional target for the local web preview's /api proxy.
# API_TARGET=http://127.0.0.1:3000
# WEB_PORT=4173
